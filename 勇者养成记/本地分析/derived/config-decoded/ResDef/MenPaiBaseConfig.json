  "records": [
    {
      "_record_index": 0,
      "_byte_offset": 20,
      "MenPaiID": 1,
      "Name": "恐狼部落",
      "IconName": "buluo_image_dao001",
      "Desc": "茂密的丛林之中响起了骇人的狼嚎，那是恐狼部落的战士率领狼群展开了新一轮的狩猎……",
      "TeachText": "丛林之中处处都是危险，让我来为你开路！",
      "UnlockChapter": 0,
      "NeedGongXian": 500,
      "IsLocked": 0,
      "_byte_length": 243
    },
    {
      "_record_index": 1,
      "_byte_offset": 263,
      "MenPaiID": 2,
      "Name": "火蜥部落",
      "IconName": "buluo_image_dao002",
      "Desc": "火蜥部落坚信整个世界都是从一条巨蜥口中吐出，因此常与巨蜥并肩作战，占据了沙漠绿洲的半壁江山。",
      "TeachText": "一个人面对沙漠可不是什么明智之举，让我来给你指明方向。",
      "UnlockChapter": 1,
      "NeedGongXian": 500,
      "IsLocked": 0,
      "_byte_length": 285
    },
    {
      "_record_index": 2,
      "_byte_offset": 548,
      "MenPaiID": 3,
      "Name": "深窟部落",
      "IconName": "buluo_image_dao003",
      "Desc": "这个神秘的部族认为宝石是神明的化身，因此千年来都居住在宝石矿洞中，以此来获得神明的庇护。",
      "TeachText": "宝石会告诉你猎物在哪，让我来教你如何击败它们。",
      "UnlockChapter": 2,
      "NeedGongXian": 500,
      "IsLocked": 0,
      "_byte_length": 267
    },
    {
      "_record_index": 3,
      "_byte_offset": 815,
      "MenPaiID": 4,
      "Name": "剑虎部落",
      "IconName": "buluo_image_dao004",
      "Desc": "剑虎部落曾经是草原南部的一个小部落，在获得了剑虎的力量之后迅速崛起，成为了草原的霸主。",
      "TeachText": "就让你见识见识，草原霸主狩猎的姿态吧。",
      "UnlockChapter": 3,
      "NeedGongXian": 500,
      "IsLocked": 0,
      "_byte_length": 252
    },
    {
      "_record_index": 4,
      "_byte_offset": 1067,
      "MenPaiID": 5,
      "Name": "巨石部落",
      "IconName": "buluo_image_dao005",
      "Desc": "这个强盛的部落建造了巨石阵将恐龙圈养，并邀请各大部落前来挑战，能够闯过巨石阵的人将能获得传说中的宝藏。",
      "TeachText": "巨石阵之外遍布着凶狠的野兽，但只要我在，一切都不是问题。",
      "UnlockChapter": 4,
      "NeedGongXian": 500,
      "IsLocked": 0,
      "_byte_length": 303
    },
    {
      "_record_index": 5,
      "_byte_offset": 1370,
      "MenPaiID": 6,
      "Name": "猛象部落",
      "IconName": "buluo_image_dao006",
      "Desc": "这个古老部族在冰川之下沉睡已久，而当冰雪消融之时，巨象的铁蹄必将震荡世界。",
      "TeachText": "你能看清暴雪之中的道路么？让我来引领你前进吧。",
      "UnlockChapter": 5,
      "NeedGongXian": 500,
      "IsLocked": 0,
      "_byte_length": 246
    },
    {
      "_record_index": 6,
      "_byte_offset": 1616,
      "MenPaiID": 7,
      "Name": "剑龙部落",
      "IconName": "buluo_image_dao007",
      "Desc": "火山之下是属于龙族的领地，但剑龙部落却能从中争得一片领土，他们用龙甲武装自己，让敌人束手无策。",
      "TeachText": "你想狩猎巨龙？呵呵，让我来给你示范示范。",
      "UnlockChapter": 6,
      "NeedGongXian": 500,
      "IsLocked": 0,
      "_byte_length": 267
    },
    {
      "_record_index": 7,
      "_byte_offset": 1883,
      "MenPaiID": 8,
      "Name": "灰烬部落",
      "IconName": "buluo_image_dao008",
      "Desc": "传说在火山深处，有一个神秘的埋骨地隐藏着神明的遗物，无数强者来到此处试图寻找，然而灰烬部落的存在，让他们有来无回。",
      "TeachText": "你想传承灰烬猎手的技艺么？那便跟我来吧。",
      "UnlockChapter": 7,
      "NeedGongXian": 500,
      "IsLocked": 0,
      "_byte_length": 297
    },
    {
      "_record_index": 8,
      "_byte_offset": 2180,
      "MenPaiID": 9,
      "Name": "翼龙部落",
      "IconName": "buluo_image_dao009",
      "Desc": "翼龙部族乘上飞龙从天而降的身影足以让任何人闻风丧胆。",
      "TeachText": "你也想成为龙背上的战士吗？很好，那便随我来吧！",
      "UnlockChapter": 8,
      "NeedGongXian": 500,
      "IsLocked": 0,
      "_byte_length": 213
    },
    {
      "_record_index": 9,
      "_byte_offset": 2393,
      "MenPaiID": 10,
      "Name": "灵语部落",
      "IconName": "buluo_image_dao010",
      "Desc": "无数战士为了寻找密藏而来到精灵森林，可当他们的战士在丛林中锁定你为目标时，逃跑或许是唯一的选择。",
      "TeachText": "森林真正的力量，你想拥有吗？如果想，那便做好觉悟，跟着我。",
      "UnlockChapter": 9,
      "NeedGongXian": 500,
      "IsLocked": 0,
      "_byte_length": 297
    },
    {
      "_record_index": 10,
      "_byte_offset": 2690,
      "MenPaiID": 11,
      "Name": "伊始部落",
      "IconName": "buluo_image_dao011",
      "Desc": "受到太阳神的指引建立的古老而神秘的文明部落，这座辉煌的古城如今依旧熠熠生辉。",
      "TeachText": "即使是克特扎尔神的羽毛，也只是短暂的停留。",
      "UnlockChapter": 10,
      "NeedGongXian": 500,
      "IsLocked": 0,
      "_byte_length": 243
    },
    {
      "_record_index": 11,
      "_byte_offset": 2933,
      "MenPaiID": 12,
      "Name": "雷鸣部落",
      "IconName": "buluo_image_dao012",
      "Desc": "雷鸣部落常年与世隔绝，凌于众生之上。",
      "TeachText": "感受雷电通体的能量吧。",
      "UnlockChapter": 11,
      "NeedGongXian": 500,
      "IsLocked": 0,
      "_byte_length": 153
    },
    {
      "_record_index": 12,
      "_byte_offset": 3086,
      "MenPaiID": 13,
      "Name": "云顶部落",
      "IconName": "buluo_image_dao013",
      "Desc": "云顶部落是位于高耸云端的山顶。在山峰的最顶端可以眺望到天空之海。",
      "TeachText": "每每站在云端，我都会感叹众生的渺小。",
      "UnlockChapter": 12,
      "NeedGongXian": 500,
      "IsLocked": 0,
      "_byte_length": 216
    },
    {
      "_record_index": 13,
      "_byte_offset": 3302,
      "MenPaiID": 14,
      "Name": "日炎部落",
      "IconName": "buluo_image_dao014",
      "Desc": "沙漠中的日炎部落拥有着勇猛无比的战士。或许神明的秘密就埋藏在他们守护的金字塔内。",
      "TeachText": "金字塔总是让人感到敬畏。",
      "UnlockChapter": 13,
      "NeedGongXian": 500,
      "IsLocked": 0,
      "_byte_length": 222
    },
    {
      "_record_index": 14,
      "_byte_offset": 3524,
      "MenPaiID": 15,
      "Name": "自然部落",
      "IconName": "buluo_image_dao016",
      "Desc": "鲜花森林风景宜人、生机盎然，但万不可因为这和谐的景象而小瞧这里的居住者。",
      "TeachText": "鲜花啊，是和谐的象征。",
      "UnlockChapter": 14,
      "NeedGongXian": 500,
      "IsLocked": 0,
      "_byte_length": 207
    },
    {
      "_record_index": 15,
      "_byte_offset": 3731,
      "MenPaiID": 16,
      "Name": "海神部落",
      "IconName": "buluo_image_dao015",
      "Desc": "受到海洋女神的恩赐，神秘的海神部落在这里栖息，守护着海底最深处的宝藏。",
      "TeachText": "颤抖吧，在海神之力面前。",
      "UnlockChapter": 15,
      "NeedGongXian": 500,
      "IsLocked": 0,
      "_byte_length": 207
    },
    {
      "_record_index": 16,
      "_byte_offset": 3938,
      "MenPaiID": 17,
      "Name": "彩虹部落",
      "IconName": "buluo_image_dao017",
      "Desc": "云雾中，有一片浮空陆地，这片陆地上生活着观虹一族，这里黄发垂髫，阡陌纵横。腹地有一帘瀑布，瀑布下方就是圣地彩虹池。",
      "TeachText": "脚踏实地向前走，风雨过后有彩虹。",
      "UnlockChapter": 16,
      "NeedGongXian": 500,
      "IsLocked": 0,
      "_byte_length": 285
    },
    {
      "_record_index": 17,
      "_byte_offset": 4223,
      "MenPaiID": 18,
      "Name": "星月部落",
      "IconName": "buluo_image_dao018",
      "Desc": "星月部落在山顶用巨石搭起祭坛，汲取星月之力，创造了独特的魔法，这里的一切似乎都被灌注了魔法的力量。",
      "TeachText": "宁静的月光蕴含着神秘的力量。",
      "UnlockChapter": 17,
      "NeedGongXian": 500,
      "IsLocked": 0,
      "_byte_length": 255
    },
    {
      "_record_index": 18,
      "_byte_offset": 4478,
      "MenPaiID": 19,
      "Name": "极光部落",
      "IconName": "buluo_image_dao019",
      "Desc": "茫茫的艾斯雪域中，有一处极为陡峭冰崖，冰崖高处是极光女王的冰雪宫殿。",
      "TeachText": "极光总是让人心驰神往。",
      "UnlockChapter": 18,
      "NeedGongXian": 500,
      "IsLocked": 0,
      "_byte_length": 201
    },
    {
      "_record_index": 19,
      "_byte_offset": 4679,
      "MenPaiID": 20,
      "Name": "圣火部落",
      "IconName": "buluo_image_dao020",
      "Desc": "火山深处埋骨地中，古老的法阵开启，一座恢弘的宫殿破地而出，这曾是火焰巨人的居所。",
      "TeachText": "这就是净化世界的烈火。",
      "UnlockChapter": 19,
      "NeedGongXian": 500,
      "IsLocked": 0,
      "_byte_length": 219
    },
    {
      "_record_index": 20,
      "_byte_offset": 4898,
      "MenPaiID": 21,
      "Name": "智械部落",
      "IconName": "buluo_image_dao021",
      "Desc": "季坦高原上保留有远古文明留下的机械智能，而这些机械智能似乎有什么使命未能完成，始终游荡在这片高原。",
      "TeachText": "想要弄懂智能器械的奥秘吗？来，我小声告诉你。",
      "UnlockChapter": 20,
      "NeedGongXian": 500,
      "IsLocked": 0,
      "_byte_length": 279
    },
    {
      "_record_index": 21,
      "_byte_offset": 5177,
      "MenPaiID": 22,
      "Name": "禁咒部落",
      "IconName": "buluo_image_dao022",
      "Desc": "峡谷深处，有一处禁咒之地，那里常年迷雾笼罩，迷雾内皆是腐败之物，进入迷雾的人们没有能够安全返回的，据说里面藏着不得了的秘密。",
      "TeachText": "泥沼之下是无尽的深渊，千万不要尝试触碰它。",
      "UnlockChapter": 21,
      "NeedGongXian": 500,
      "IsLocked": 0,
      "_byte_length": 315
    },
    {
      "_record_index": 22,
      "_byte_offset": 5492,
      "MenPaiID": 23,
      "Name": "暗裔部落",
      "IconName": "buluo_image_dao023",
      "Desc": "很久之前，有一个充满杀戮气息的部落，它们踏入过的任何地方，都将变得一片狼藉。且有传闻，被暗裔族人杀死的灵魂，会被永久封锁在暗裔武器之中。",
      "TeachText": "暗裔侵蚀过的地方，将毫无生机。",
      "UnlockChapter": 22,
      "NeedGongXian": 500,
      "IsLocked": 0,
      "_byte_length": 315
    },
    {
      "_record_index": 23,
      "_byte_offset": 5807,
      "MenPaiID": 24,
      "Name": "青藤部落",
      "IconName": "buluo_image_dao024",
      "Desc": "藤蔓山谷，以遍布漫山的藤蔓而出名，谷中一处秘境生长着一株麻花型缠绕的巨型藤蔓，藤蔓下方每隔数日，会结出一滴灵水。部落族人以此灵水清洗双目，来获得鹰一般的视力。",
      "TeachText": "巨型藤蔓的生长将永无止境。",
      "UnlockChapter": 23,
      "NeedGongXian": 500,
      "IsLocked": 0,
      "_byte_length": 342
    },
    {
      "_record_index": 24,
      "_byte_offset": 6149,
      "MenPaiID": 25,
      "Name": "蛮荒部落",
      "IconName": "buluo_image_dao025",
      "Desc": "蛮荒部落位于沙漠深处，因为长期生存在艰苦环境下，部落族人体魄十分彪悍。传说，有两只凶恶的沙漠火蜥守护着族人，令入侵者不敢随意进犯。",
      "TeachText": "只有极少人能从蛮荒的沙尘暴中生还。",
      "UnlockChapter": 24,
      "NeedGongXian": 500,
      "IsLocked": 0,
      "_byte_length": 312
    },
    {
      "_record_index": 25,
      "_byte_offset": 6461,
      "MenPaiID": 26,
      "Name": "龙侍部落",
      "IconName": "buluo_image_dao026",
      "Desc": "唤魔海域深处,古老的宫殿大门缓缓开启，青铜钟的声音在整片海域中回荡,沉眠于此的龙侍一族再度苏醒,这是来自青铜王座主人的呼唤",
      "TeachText": "苏醒吧!再创远古辉煌!",
      "UnlockChapter": 25,
      "NeedGongXian": 500,
      "IsLocked": 0,
      "_byte_length": 272
    },
    {
      "_record_index": 26,
      "_byte_offset": 6733,
      "MenPaiID": 27,
      "Name": "岩渊部落",
      "IconName": "buluo_image_dao027",
      "Desc": "地下深处的岩渊部落并未屈服于黑暗中的恶劣环境。他们勇敢地面对黑暗，以顽强的毅力和智慧抵抗外敌和魔兽的侵袭。",
      "TeachText": "敬畏黑暗，融入黑暗。",
      "UnlockChapter": 26,
      "NeedGongXian": 500,
      "IsLocked": 0,
      "_byte_length": 255
    },
    {
      "_record_index": 27,
      "_byte_offset": 6988,
      "MenPaiID": 28,
      "Name": "暗夜部落",
      "IconName": "buluo_image_dao028",
      "Desc": "在庞大的世界树根上,有一个古老而与世隔绝的神秘部落,尽管他们通常都隐匿起来,但外来者的行为了如指掌,不知是敌是友…·",
      "TeachText": "黑夜降临，星辰烁烁。",
      "UnlockChapter": 27,
      "NeedGongXian": 500,
      "IsLocked": 0,
      "_byte_length": 261
    },
    {
      "_record_index": 28,
      "_byte_offset": 7249,
      "MenPaiID": 29,
      "Name": "雪神部落",
      "IconName": "buluo_image_dao029",
